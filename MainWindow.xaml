<Window x:Class="GeminiScreenPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gemini Desktop Companion"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="220" Height="220"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Modern Windows Acrylic / Glassmorphism Context Menu Style -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#CC121626"/>
            <Setter Property="BorderBrush" Value="#45FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="8" Opacity="0.6"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Header"/>
                                <Popup x:Name="SubMenuPopup" Grid.Column="1" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right">
                                    <Border Background="#D5121626" BorderBrush="#45FFFFFF" BorderThickness="1" CornerRadius="14" Padding="6">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="6" Opacity="0.55"/>
                                        </Border.Effect>
                                        <StackPanel IsItemsHost="True"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#25FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="#25FFFFFF"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Height" Value="1"/>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu>
            <!-- Hunger Bar Status Widget -->
            <MenuItem StaysOpenOnClick="True">
                <MenuItem.Header>
                    <StackPanel Width="170" Margin="0,2,0,4">
                        <Grid>
                            <TextBlock Text="🍗 Сытость" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="HungerPercentText" Text="100%" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Height="6" CornerRadius="3" Background="#20FFFFFF" Margin="0,4,0,0">
                            <ProgressBar x:Name="HungerProgressBar" Value="100" Maximum="100" Height="6" BorderThickness="0" Background="Transparent" Foreground="#38BDF8"/>
                        </Border>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>

            <!-- Speed Slider Control Widget -->
            <MenuItem StaysOpenOnClick="True">
                <MenuItem.Header>
                    <StackPanel Width="170" Margin="0,2,0,4">
                        <Grid>
                            <TextBlock Text="⚡ Скорость шага" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SpeedValueText" Text="4.0x" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="SpeedSlider" Minimum="1.0" Maximum="10.0" Value="4.0" ValueChanged="SpeedSlider_ValueChanged" Margin="0,4,0,0"/>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>

            <Separator/>
            <MenuItem Header="🎯 Режим: Следовать за курсором" Click="MenuFollowToggle_Click" x:Name="MenuFollowItem"/>
            
            <MenuItem Header="🎨 Тема и Расцветка">
                <MenuItem Header="✨ Официальный Gemini (Deep Blue / Purple)" Click="MenuThemeOfficial_Click"/>
                <MenuItem Header="⚫⚪ Чёрно-Белый Minimal (Monochrome)" Click="MenuThemeMono_Click"/>
            </MenuItem>

            <MenuItem Header="🌈 Хвост / Шлейф">
                <MenuItem Header="💙 Неоновый синий (Default)" Click="MenuTrailCyan_Click"/>
                <MenuItem Header="🌈 Радужный спектр" Click="MenuTrailRainbow_Click"/>
                <MenuItem Header="🔥 Огненно-золотой" Click="MenuTrailFire_Click"/>
                <MenuItem Header="💖 Розовое сияние" Click="MenuTrailPink_Click"/>
                <MenuItem Header="✨ Звёздная пыль" Click="MenuTrailSparkle_Click"/>
                <MenuItem Header="⚪ Без шлейфа" Click="MenuTrailNone_Click"/>
            </MenuItem>

            <Separator/>
            <MenuItem Header="⭐ Покормить звёздочкой" Click="MenuFeed_Click"/>
            <MenuItem Header="❤️ Любовный режим" Click="MenuLove_Click"/>
            <MenuItem Header="🎉 Супер-Звезда (Party)" Click="MenuParty_Click"/>
            <MenuItem Header="💫 Покружиться" Click="MenuSpin_Click"/>
            <MenuItem Header="👥 Клонировать (Митоз)" Click="MenuClone_Click"/>
            <MenuItem Header="🧲 Объединить всех в одного" Click="MenuMerge_Click"/>
            <MenuItem Header="🕶️ Крутые очки" Click="MenuGlasses_Click"/>
            <MenuItem Header="🚀 Запуск вместе с Windows" Click="MenuAutoStart_Click" x:Name="MenuAutoStartItem"/>
            <MenuItem Header="😴 Уложить спать" Click="MenuSleep_Click"/>
            <Separator/>
            <MenuItem Header="📥 Спрятать в системный трей" Click="MenuHideToTray_Click"/>
            <MenuItem Header="❌ Закрыть Gemini" Click="MenuExit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid>
        <!-- Speech Bubble (Frosted Glass style - Acrylic matching Menu) -->
        <Border x:Name="SpeechBorder"
                Visibility="Collapsed"
                Background="#CC121626"
                CornerRadius="14"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                Padding="12,7"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,6,0,0">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="5" Opacity="0.55"/>
            </Border.Effect>
            <TextBlock x:Name="SpeechText"
                       Foreground="#F8FAFC"
                       FontSize="11.5"
                       FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                       FontWeight="SemiBold"
                       Text="✨ Привет!"/>
        </Border>

        <!-- Pet Body Container with Squash & Stretch + Smooth Physics -->
        <Canvas x:Name="PetContainer"
                Width="100" Height="100"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,10"
                RenderTransformOrigin="0.5, 0.5">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PetScale" ScaleX="1.0" ScaleY="1.0" CenterX="50" CenterY="50"/>
                    <RotateTransform x:Name="PetRotate" Angle="0" CenterX="50" CenterY="50"/>
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- Dynamic Aura Glow with Breathing Animation -->
            <Ellipse x:Name="GlowEllipse" Width="96" Height="96" Canvas.Left="2" Canvas.Top="2" Opacity="0.65">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop x:Name="GlowColor1" Color="#9038BDF8" Offset="0.0"/>
                        <GradientStop x:Name="GlowColor2" Color="#50818CF8" Offset="0.55"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- 32x32 Pixel Grid Canvas -->
            <Canvas x:Name="PixelGrid" Width="84" Height="84" Canvas.Left="8" Canvas.Top="8">
            </Canvas>
        </Canvas>
    </Grid>
</Window>
