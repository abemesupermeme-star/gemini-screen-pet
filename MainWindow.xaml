<Window x:Class="GeminiScreenPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gemini Desktop Companion"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="220" Height="220"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Modern Cyberpunk Context Menu Style -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#F20A0F1D"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect Color="#0284C7" BlurRadius="20" ShadowDepth="4" Opacity="0.85"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F0F9FF"/>
            <Setter Property="FontFamily" Value="Segoe UI, Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3038BDF8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="Height" Value="1"/>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="✨ Поздороваться" Click="MenuSayHi_Click"/>
            <MenuItem Header="❤️ Любовный режим" Click="MenuLove_Click"/>
            <MenuItem Header="🎉 Супер-Звезда (Party)" Click="MenuParty_Click"/>
            <MenuItem Header="💫 Покружиться" Click="MenuSpin_Click"/>
            <MenuItem Header="⭐ Дать звёздочку" Click="MenuFeed_Click"/>
            <MenuItem Header="👥 Клонировать (Митоз)" Click="MenuClone_Click"/>
            <MenuItem Header="🧲 Объединить всех в одного" Click="MenuMerge_Click"/>
            <MenuItem Header="🕶️ Крутые очки" Click="MenuGlasses_Click"/>
            <MenuItem Header="😴 Уложить спать" Click="MenuSleep_Click"/>
            <Separator/>
            <MenuItem Header="❌ Закрыть Gemini" Click="MenuExit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid>
        <!-- Speech Bubble with Animation -->
        <Border x:Name="SpeechBorder"
                Visibility="Collapsed"
                Background="#EE0B1120"
                CornerRadius="12"
                BorderBrush="#38BDF8"
                BorderThickness="1.5"
                Padding="10,6"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,5,0,0">
            <Border.Effect>
                <DropShadowEffect Color="#0284C7" BlurRadius="16" ShadowDepth="2" Opacity="0.9"/>
            </Border.Effect>
            <TextBlock x:Name="SpeechText"
                       Foreground="#F0F9FF"
                       FontSize="11"
                       FontFamily="Segoe UI, Tahoma"
                       FontWeight="Bold"
                       Text="✨ Привет!"/>
        </Border>

        <!-- Pet Body Container -->
        <Canvas x:Name="PetContainer"
                Width="100" Height="100"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,10"
                RenderTransformOrigin="0.5, 0.5">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PetScale" ScaleX="1.0" ScaleY="1.0" CenterX="50" CenterY="50"/>
                    <RotateTransform x:Name="PetRotate" Angle="0" CenterX="50" CenterY="50"/>
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- Dynamic Aura Glow -->
            <Ellipse x:Name="GlowEllipse" Width="94" Height="94" Canvas.Left="3" Canvas.Top="3" Opacity="0.6">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop x:Name="GlowColor1" Color="#9038BDF8" Offset="0.0"/>
                        <GradientStop x:Name="GlowColor2" Color="#50818CF8" Offset="0.55"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Pixel Grid Canvas -->
            <Canvas x:Name="PixelGrid" Width="80" Height="80" Canvas.Left="10" Canvas.Top="10">
            </Canvas>
        </Canvas>
    </Grid>
</Window>
